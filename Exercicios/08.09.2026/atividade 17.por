programa {
    funcao inicio() {
        logico v = verdadeiro, f = falso
        escreva("V e V: ", v e v, " | V ou V: ", v ou v, "\n")
        escreva("V e F: ", v e f, " | V ou F: ", v ou f, "\n")
        escreva("F e V: ", f e v, " | F ou V: ", f ou v, "\n")
        escreva("F e F: ", f e f, " | F ou F: ", f ou f, "\n")
    }
}