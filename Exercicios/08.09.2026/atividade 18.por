programa {
    funcao inicio() {
        cadeia nome, cidade
        inteiro idade
        escreva("Nome: ")
        leia(nome)
        escreva("Idade: ")
        leia(idade)
        escreva("Cidade: ")
        leia(cidade)
        escreva("Meu nome é ", nome, ", tenho ", idade, " anos e moro em ", cidade, ".")
    }
}